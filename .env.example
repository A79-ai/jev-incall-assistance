# Export these in your shell. This file is not loaded automatically.
TYPESAFE_API_KEY=replace_with_your_key
JEV_MODEL=jev-1.13.0
# Gateway only: generate at least 32 random characters for generic senders.
JEV_INGEST_TOKEN=replace_with_a_random_token_at_least_32_characters
# Recall integration: workspace verification secret, not the API key.
RECALL_WEBHOOK_SECRET=whsec_replace_with_your_workspace_secret
# Used by the Google Meet quick-start curl commands only.
RECALL_API_KEY=replace_with_your_recall_api_key
RECALL_REGION=us-west-2
